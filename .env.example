DATABASE_URL=postgres://xupay:CHANGE_ME@127.0.0.1:18862/xupay?sslmode=disable
MASTER_KEY=GENERATE_BASE64_32_BYTE_SECRET
PORT=18860
LISTEN_HOST=127.0.0.1
COOKIE_SECURE=false
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=GENERATE_UNIQUE_PASSWORD
POSTGRES_PASSWORD=CHANGE_ME
# Docker publication; database has no host port.
XUPAY_BIND=0.0.0.0
XUPAY_PORT=5496
# Optional desktop-only outer HTTP proxy; production should leave unset.
# Windows start-local.ps1 discovers the enabled system proxy automatically.
# XUPAY_LOCAL_PROXY=http://127.0.0.1:7897
# XUPAY_LOCAL_PROXY=off
